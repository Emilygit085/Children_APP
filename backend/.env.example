# 复制为 .env 后按需修改（勿提交含真实密码的 .env）。
#
# --- 本地 SQLite（仅开发、无 Docker MySQL 时）---
# DATABASE_URL=sqlite:///./app.db
#
# --- MySQL（与 Docker 见 docker-compose.db.yml + .env.docker）---
# 若仍用 SQLite，请注释掉下面 DATABASE_URL 并启用上一行。
# 账号密码需与 .env.docker 中 MYSQL_USER / MYSQL_PASSWORD 一致。
DATABASE_URL=mysql+pymysql://social_app:change-app-password@127.0.0.1:3306/social_app
#
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 生产环境填写前端域名；本地 Flutter Web 可保留 localhost 端口
CORS_ORIGINS=https://your-frontend.example.com,http://localhost:49873,http://127.0.0.1:49873
# Tencent COS (optional; leave empty to disable presign)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_DOMAIN=
